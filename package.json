{
  "name": "@anierbeck/pi-mistral-bridge",
  "version": "0.1.4",
  "description": "Pi extension exposing Mistral models via the user's vibe-acp over ACP",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "mistral",
    "vibe",
    "acp"
  ],
  "author": "ANierbeck",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ANierbeck/pi-mistral-bridge"
  },
  "homepage": "https://github.com/ANierbeck/pi-mistral-bridge#readme",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/adr"
  ],
  "scripts": {
    "build": "npm run typecheck && node scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "node scripts/lint.ts",
    "format": "node scripts/format.ts --write",
    "format:check": "node scripts/format.ts",
    "secret-scan": "node scripts/secret-scan.ts --staged-only",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git config core.hooksPath .githooks; fi",
    "prepublishOnly": "if [ -z \"$(git tag --points-at HEAD 2>/dev/null)\" ]; then echo \"prepublishOnly: no git tag at HEAD - publishing requires an explicit release approval naming the version (AGENTS.md section 1)\"; exit 1; fi"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.9.1",
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.7.0",
    "@earendil-works/pi-coding-agent": "^1.7.0",
    "@earendil-works/pi-tui": "^1.7.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
